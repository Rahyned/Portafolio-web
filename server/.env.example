# Copiar este archivo a `.env` y completar con tus datos.
# Sin SMTP configurado, el servidor guarda los mensajes en server/inbox/messages.jsonl.

# Puerto del servidor
PORT=8080

# ---------- SMTP (ej: Gmail, Mailtrap, Brevo, etc.) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email que recibe los mensajes del formulario
CONTACT_EMAIL=
