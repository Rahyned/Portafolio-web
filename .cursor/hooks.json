{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "node .cursor/hooks/oxlint-check.mjs",
        "type": "command",
        "failClosed": false,
        "timeout": 60,
        "matcher": "^Write$"
      },
      {
        "command": "node .cursor/hooks/json-check.mjs",
        "type": "command",
        "failClosed": false,
        "timeout": 10,
        "matcher": "^Write$"
      }
    ]
  }
}
