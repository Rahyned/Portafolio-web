{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "default_agent": "programador",
  "skills": {
    "paths": [".agents/skills"]
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny"
    },
    "bash": {
      "*": "allow",
      "git * push*": "deny",
      "git push*": "deny"
    }
  }
}
