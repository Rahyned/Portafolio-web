{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/asistente/", "destination": "https://rag-proyectos.vercel.app/" },
    { "source": "/asistente/:path*", "destination": "https://rag-proyectos.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}