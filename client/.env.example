# Variables de entorno del frontend (Vercel: Settings → Environment Variables).
# En local NO hacen falta: sin LLM_*, /api/chat responde 503 elegante.
# OJO: sin prefijo VITE_ a propósito — así nunca se empaquetan en el bundle del browser.

# ---------- LLM (chat del Profesor Oak) ----------
# Proveedor con API compatible con OpenAI: Groq, OpenRouter, Gemini, Mistral, etc.
# Base URL sin slash final: el backend le agrega /chat/completions
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------- Upstash Redis (rate limit global + cuota diaria del chat) ----------
# Opcional: sin esto el rate limit es por instancia (memoria) y la cuota
# diaria solo vive en el cliente. https://upstash.com → Create database
# (plan Free) → pestaña Redis → REST API → copiar URL y Token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- SMTP (formulario de contacto) ----------
# Mismas variables que server/.env (ver server/.env.example).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
